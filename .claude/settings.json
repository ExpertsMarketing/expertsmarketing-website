{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin *)",
      "Bash(git pull)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr merge * --auto*)",
      "Bash(gh pr close*)",
      "Bash(gh api repos/ExpertsMarketing/expertsmarketing-website/pulls*)"
    ],
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git branch -D main)",
      "Bash(gh api *branches/main/protection*)",
      "Bash(gh repo delete*)",
      "Bash(gh api *DELETE*)"
    ]
  }
}
